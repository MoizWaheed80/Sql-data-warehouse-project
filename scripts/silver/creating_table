/*
===============================================================================
Create SilverLayer Tables
===============================================================================
Description:
    This script recreates all Silverlayer tables.
    Existing tables are dropped before being created again.
===============================================================================
*/


-- Drop Existing Tables

IF OBJECT_ID('silver.crm_sale_detail', 'U') IS NOT NULL
    DROP TABLE silver.crm_sale_detail;
GO

IF OBJECT_ID('silver.crm_product_info', 'U') IS NOT NULL
    DROP TABLE silver.crm_product_info;
GO

IF OBJECT_ID('silver.crm_customer_info', 'U') IS NOT NULL
    DROP TABLE silver.crm_customer_info;
GO

IF OBJECT_ID('silver.erp_product_info', 'U') IS NOT NULL
    DROP TABLE silver.erp_product_info;
GO

IF OBJECT_ID('silver.erp_location_info', 'U') IS NOT NULL
    DROP TABLE silver.erp_location_info;
GO

IF OBJECT_ID('silver.erp_customer_info', 'U') IS NOT NULL
    DROP TABLE silver.erp_customer_info;
GO

--=============================================================================

-- CRM Customer Information

CREATE TABLE silver.crm_customer_info
(
    cst_id              INT,
    cst_key             NVARCHAR(50),
    cst_firstname       NVARCHAR(50),
    cst_lastname        NVARCHAR(50),
    cst_marital_status  NVARCHAR(50),
    cst_gndr            NVARCHAR(50),
    cst_create_date     DATE,
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO


-- CRM Product Information

CREATE TABLE silver.crm_product_info
(
    prd_id          INT,
    prd_key         NVARCHAR(50),
    prd_name        NVARCHAR(80),
    prd_cost        INT,
    prd_line        NVARCHAR(50),
    prd_start_dt    DATE,
    prd_end_dt      DATE,
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO


-- CRM Sales Details

CREATE TABLE silver.crm_sale_detail
(
    sls_ord_num     NVARCHAR(50),
    sls_prd_key     NVARCHAR(50),
    sls_cust_id     INT,
    sls_order_dt    INT,
    sls_ship_dt     INT,
    sls_due_dt      INT,
    sls_sales       INT,
    sls_quantity    INT,
    sls_price       INT,
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO


-- ERP Customer Information

CREATE TABLE silver.erp_customer_info
(
    CID     NVARCHAR(50),
    BDATE   DATE,
    GEN     NVARCHAR(50),
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO


-- ERP Location Information

CREATE TABLE silver.erp_location_info
(
    CID     NVARCHAR(50),
    CNTRY   NVARCHAR(50),
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO


-- ERP Product Information

CREATE TABLE silver.erp_product_info
(
    ID           NVARCHAR(50),
    CAT          NVARCHAR(50),
    SUBCAT       NVARCHAR(50),
    MAINTENANCE  NVARCHAR(50),
    dwh_create_date     DATETIME2 Default GETDATE()
);
GO
