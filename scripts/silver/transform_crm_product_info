/*
=========================================================
Transform CRM Product Data (Bronze → Silver)
=========================================================
Purpose:
    - Clean product data
    - Extract category ID from product key
    - Standardize product line values
    - Replace NULL product costs with 0
    - Calculate product end date using the next start date
=========================================================
*/

INSERT INTO silver.crm_product_info
(
    prd_id,
    cat_id,
    prd_key,
    prd_name,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)

SELECT
    -- Product ID
    prd_id,

    -- Extract category ID (first 5 characters)
    REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,

    -- Product Key (remove category prefix)
    SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key,

    -- Product Name
    TRIM(prd_nm) AS prd_name,

    -- Replace NULL cost with 0
    ISNULL(prd_cost, 0) AS prd_cost,

    -- Standardize product line values
    CASE UPPER(TRIM(prd_line))
        WHEN 'M' THEN 'Mountain'
        WHEN 'R' THEN 'Road'
        WHEN 'S' THEN 'Other Sales'
        WHEN 'T' THEN 'Touring'
        ELSE 'N/A'
    END AS prd_line,

    -- Product Start Date
    CAST(prd_start_dt AS DATE) AS prd_start_dt,

    -- Product End Date (one day before next start date)
    CAST(
        DATEADD(
            DAY,
            -1,
            LEAD(prd_start_dt)
                OVER (PARTITION BY prd_key ORDER BY prd_start_dt)
        ) AS DATE
    ) AS prd_end_dt

FROM bronze.crm_product_info;
