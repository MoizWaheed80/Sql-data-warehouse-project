/*
=========================================================
Create Silver Layer Tables
=========================================================
Purpose:
    Recreate all Silver layer tables.
    - If a table already exists, drop it.
    - Then create a fresh table.
=========================================================
*/

USE DataWarehouse;
GO

/*=========================================================
Create Table: silver.crm_customer_info
=========================================================*/
IF OBJECT_ID('silver.crm_customer_info', 'U') IS NOT NULL
    DROP TABLE silver.crm_customer_info;
GO

CREATE TABLE silver.crm_customer_info
(
    cst_id              INT,
    cst_key             NVARCHAR(50),
    cst_firstname       NVARCHAR(50),
    cst_lastname        NVARCHAR(50),
    cst_gndr            NVARCHAR(10),
    cst_marital_status  NVARCHAR(20),
    cst_create_date     DATE,

    dwh_create_date     DATETIME2 DEFAULT GETDATE()
);
GO

